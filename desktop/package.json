{
  "name": "contextspace-desktop",
  "version": "2.10.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "setup": "install-electron",
    "prepare-backend": "node scripts/prepare-backend.mjs",
    "pack": "npm run prepare-backend && electron-builder --dir",
    "build": "npm run prepare-backend && electron-builder --publish never",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "se.hogia.contextspace",
    "productName": "ContextSpace",
    "directories": {
      "buildResources": "assets"
    },
    "afterPack": "./scripts/verify-backend.mjs",
    "files": [
      "main.js",
      "lib/**/*",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "ContextSpaceSetup.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NexusFlow-${version}.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "antan87",
        "repo": "NexusFlow",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "directories": {
      "output": "dist"
    }
  }
}
