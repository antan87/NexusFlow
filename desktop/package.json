{
  "name": "nexusflow-desktop",
  "version": "1.5.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-backend": "node scripts/prepare-backend.mjs",
    "pack": "npm run prepare-backend && electron-builder --dir",
    "build": "npm run prepare-backend && electron-builder",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@43.1.0": true
  },
  "build": {
    "appId": "se.hogia.nexusflow",
    "productName": "NexusFlow",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "NexusFlowSetup.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
