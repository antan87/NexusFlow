{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "js.neutralino.nexusflow",
  "version": "1.3.2",
  "applicationIcon": "resources/app_logo.png",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "NexusFlow Dashboard",
      "icon": "/resources/app_logo.png",
      "width": 1000,
      "height": 700,
      "minWidth": 400,
      "minHeight": 300,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": true,
      "openInspectorOnStartup": false,
      "resizable": true
    }
  },
  "cli": {
    "binaryName": "nexusflow-desktop",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0"
  }
}