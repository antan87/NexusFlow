{
  "name": "nexusflow-vscode",
  "displayName": "NexusFlow Multi-Repo Workspace Orchestrator",
  "description": "Manage multiple repositories as a single feature workspace, orchestrate background services, and align AI coding contexts natively inside VS Code.",
  "version": "1.0.0",
  "publisher": "nexusflow",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:nexusflow.json"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "nexusflow-mcp",
        "label": "NexusFlow MCP Server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexusflow-sidebar",
          "title": "NexusFlow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nexusflow-sidebar": [
        {
          "type": "webview",
          "id": "nexusflow.dashboardView",
          "name": "NexusFlow Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "nexusflow.openDashboard",
        "title": "NexusFlow: Open Dashboard"
      },
      {
        "command": "nexusflow.openTui",
        "title": "NexusFlow: Open Terminal GUI (TUI)"
      },
      {
        "command": "nexusflow.syncWorkspace",
        "title": "NexusFlow: Sync Workspace"
      },
      {
        "command": "nexusflow.runDoctor",
        "title": "NexusFlow: Run Doctor Diagnostics"
      },
      {
        "command": "nexusflow.commitWorkspace",
        "title": "NexusFlow: Commit Workspace Changes"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.5.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "@vscode/test-electron": "^3.0.0"
  }
}
