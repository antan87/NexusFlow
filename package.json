{
  "name": "@mrpatronz/nexusflow",
  "version": "0.2.7",
  "description": "Combine multiple repos into a workspace with rich AI assistant context",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nexusflow": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build --prefix gui && npm run extension:compile",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "extension:install": "npm install --prefix extension",
    "extension:compile": "npm run compile --prefix extension"
  },
  "keywords": [
    "ai",
    "workspace",
    "multi-repo",
    "claude",
    "codex",
    "copilot",
    "cursor",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "fs-extra": "^11.2.0",
    "globby": "^14.1.0",
    "hono": "^4.12.23",
    "ora": "^8.1.0",
    "repomix": "^0.2.16"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
