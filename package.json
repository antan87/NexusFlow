{
  "name": "@mrpatronz/nexusflow",
  "version": "1.3.1",
  "description": "Combine multiple repos into a workspace with rich AI assistant context",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antan87/NexusFlow.git"
  },
  "main": "dist/index.js",
  "bin": {
    "nexusflow": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && npm run build --prefix gui",
    "version": "node scripts/sync-version.mjs && git add -A",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "ui": "node dist/index.js ui",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:gui": "npm run test:e2e --prefix gui",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "extension:install": "npm install --prefix extension",
    "extension:compile": "npm run compile --prefix extension"
  },
  "keywords": [
    "ai",
    "workspace",
    "multi-repo",
    "claude",
    "codex",
    "copilot",
    "cursor",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "execa": "^9.5.0",
    "fs-extra": "^11.2.0",
    "globby": "^16.2.0",
    "hono": "^4.12.25",
    "ora": "^9.4.0",
    "pm2": "^7.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.3",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
