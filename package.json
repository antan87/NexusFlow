{
  "name": "@mrpatronz/nexusflow",
  "version": "2.9.0",
  "description": "Combine multiple repos into a workspace with rich AI assistant context",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antan87/NexusFlow.git"
  },
  "main": "dist/index.js",
  "bin": {
    "nexusflow": "dist/index.js"
  },
  "files": [
    "dist",
    "resources"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && node scripts/copy-resources.mjs && npm run build --prefix gui",
    "build:backend": "tsc && node scripts/copy-resources.mjs",
    "version": "node scripts/sync-version.mjs && git add -A",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "ui": "node dist/index.js ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gui": "npm run test:e2e --prefix gui",
    "smoke:chat": "npx tsx scripts/smoke-chat-engines.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "extension:install": "npm install --prefix extension",
    "extension:compile": "npm run compile --prefix extension"
  },
  "keywords": [
    "ai",
    "workspace",
    "multi-repo",
    "claude",
    "codex",
    "copilot",
    "cursor",
    "developer-tools"
  ],
  "author": "MrPatronHogia",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.10.0",
    "@hono/node-server": "^2.0.8",
    "@hono/node-ws": "^1.3.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.150.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.6",
    "globby": "^16.2.0",
    "hono": "^4.12.27",
    "js-yaml": "^5.2.3",
    "openai": "^6.45.0",
    "ora": "^9.4.1",
    "pm2": "^7.0.3",
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-ws": {
      "@hono/node-server": "$@hono/node-server"
    }
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
